---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
}

const {
  title = 'Deway — Field Notes',
  description = 'Software, infrastructure and field notes.',
  canonical,
  image = '/og/default.png',
  imageAlt = 'Deway — Field Notes',
  type = 'website',
  publishedAt,
} = Astro.props;

const siteOrigin = process.env.PUBLIC_SITE_URL || Astro.site?.toString() || Astro.url.origin;
const canonicalURL = new URL(canonical || Astro.url.pathname, siteOrigin);
const imageURL = new URL(image, siteOrigin);
---

<!doctype html>
<html lang="en-gb" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1f1e1b" />
    <meta property="og:site_name" content="Deway — Field Notes" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:secure_url" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{title}</title>
    <script is:inline>
      const storedTheme = localStorage.getItem('deway-theme');
      const theme = storedTheme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    </script>
    <script is:inline defer src="/insight.js" data-website-id="b41cf413-05ec-4c4d-94c2-145f0af62a8d"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script is:inline>
      const toggle = document.querySelector('.theme-toggle');
      if (toggle) {
        toggle.addEventListener('click', function () {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('deway-theme', next);
        });
      }

      document.querySelectorAll('pre').forEach(function (pre) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-code';
        button.textContent = 'copy';
        button.addEventListener('click', function () {
          navigator.clipboard.writeText(pre.innerText.replace(/^copy\s*/, '')).then(function () {
            button.textContent = 'copied';
            window.setTimeout(function () { button.textContent = 'copy'; }, 1400);
          });
        });
        pre.appendChild(button);
      });

      const progress = document.querySelector('[data-reading-progress]');
      if (progress) {
        let progressFrame;
        const updateProgress = function () {
          progressFrame = undefined;
          const height = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = height > 0 ? Math.min(window.scrollY / height, 1) : 0;
          progress.style.transform = `scaleX(${ratio})`;
        };
        const scheduleProgressUpdate = function () {
          if (progressFrame) return;
          progressFrame = window.requestAnimationFrame(updateProgress);
        };
        updateProgress();
        window.addEventListener('scroll', scheduleProgressUpdate, { passive: true });
        window.addEventListener('resize', scheduleProgressUpdate);
      }

      const toc = document.querySelector('[data-article-toc]');
      const headings = Array.from(document.querySelectorAll('.classic-post .prose h2'));
      if (toc && headings.length) {
        headings.forEach(function (heading, index) {
          if (!heading.id) heading.id = `section-${index + 1}`;
          const link = document.createElement('a');
          link.href = `#${heading.id}`;
          link.textContent = `${String(index + 1).padStart(2, '0')}  ${heading.textContent}`;
          link.dataset.tocTarget = heading.id;
          toc.appendChild(link);
        });

        const tocLinks = Array.from(toc.querySelectorAll('a'));
        let tocFrame;

        const updateActiveHeading = function () {
          tocFrame = undefined;
          const readingLine = Math.min(240, Math.max(96, window.innerHeight * 0.26));
          let activeHeading = null;

          headings.forEach(function (heading) {
            if (heading.getBoundingClientRect().top <= readingLine) activeHeading = heading;
          });

          tocLinks.forEach(function (link) {
            const isActive = Boolean(activeHeading && link.dataset.tocTarget === activeHeading.id);
            link.classList.toggle('is-active', isActive);
            if (isActive) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        };

        const scheduleTocUpdate = function () {
          if (tocFrame) return;
          tocFrame = window.requestAnimationFrame(updateActiveHeading);
        };

        updateActiveHeading();
        window.addEventListener('scroll', scheduleTocUpdate, { passive: true });
        window.addEventListener('resize', scheduleTocUpdate);
        window.addEventListener('hashchange', scheduleTocUpdate);
      }

      const revealItems = document.querySelectorAll('[data-reveal]');
      if (revealItems.length) {
        document.documentElement.classList.add('motion-ready');
        const revealObserver = new IntersectionObserver(function (entries) {
          const visibleEntries = entries
            .filter(function (entry) { return entry.isIntersecting; })
            .sort(function (a, b) {
              return Number(a.target.dataset.revealOrder || 0) - Number(b.target.dataset.revealOrder || 0);
            });

          visibleEntries.forEach(function (entry, batchIndex) {
            const order = Number(entry.target.dataset.revealOrder || 0);
            const inferenceDelay = entry.target.classList.contains('session-message--assistant')
              ? 440 + (order % 3) * 90
              : 0;
            window.setTimeout(function () {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }, inferenceDelay + batchIndex * 110);
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -14% 0px' });
        revealItems.forEach(function (item, index) {
          item.dataset.revealOrder = String(index);
          revealObserver.observe(item);
        });
      }
    </script>
  </body>
</html>
