---
import PostLayout from '../../layouts/PostLayout.astro';
import SessionTranscript from '../../components/SessionTranscript.astro';
import ContentWidgets from '../../components/ContentWidgets.astro';
import { getPreviewPost } from '../../lib/payload';

export const prerender = false;

const post = await getPreviewPost(
  Astro.params.id || '',
  Astro.url.searchParams.get('secret') || '',
);

if (!post) {
  return new Response('Contenu introuvable', { status: 404 });
}
---

<PostLayout post={post} preview>
  {post.type === 'session' ? (
    <SessionTranscript messages={post.messages} />
  ) : (
    <>
      <div class="prose" set:html={post.body || ''} />
      <ContentWidgets widgets={post.widgets} context="article" />
    </>
  )}
</PostLayout>

<script>
  import { isDocumentEvent, ready } from '@payloadcms/live-preview';

  const serverURL = window.location.origin;
  let refreshTimer: ReturnType<typeof setTimeout> | undefined;

  window.addEventListener('message', (event) => {
    if (!isDocumentEvent(event, serverURL)) return;
    window.clearTimeout(refreshTimer);
    refreshTimer = window.setTimeout(() => window.location.reload(), 120);
  });

  ready({ serverURL });
</script>
